<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notebook.db" />
        <exclude domain="database" path="notebook.db-wal" />
        <exclude domain="database" path="notebook.db-shm" />
        <exclude domain="file" path="attachments" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
